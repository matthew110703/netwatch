# ============================================================================
# Netwatch Native — Environment Configuration
# ============================================================================
# In local development (`pnpm dev:native`, `pnpm android`, `pnpm ios`),
# no EXPO_PUBLIC_API_URL is required: the app automatically probes local
# emulator aliases (10.0.2.2 / 127.0.0.1 / localhost) and Metro hostUri across
# ports 3000..3002 and verifies `service === "netwatch"` via `/api/health`.
#
# For staging / production builds (or remote physical device testing),
# set EXPO_PUBLIC_API_URL to your deployed Netwatch web BFF URL:
# ============================================================================

APP_ENV=development
EXPO_PUBLIC_APP_ENV=development
# EXPO_PUBLIC_API_URL=https://netwatch.example.com
# EXPO_PUBLIC_NETWATCH_PORT=3000
