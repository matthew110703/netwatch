    "build:native:dev": "node scripts/build-native.mjs bundle development all",
    "build:native:staging": "node scripts/build-native.mjs bundle staging all",
    "build:native:prod": "node scripts/build-native.mjs bundle production all",
    "build:native:android:prod": "node scripts/build-native.mjs bundle production android",
    "build:native:ios:prod": "node scripts/build-native.mjs bundle production ios",
    "eas:build:dev": "node scripts/build-native.mjs eas development all",
